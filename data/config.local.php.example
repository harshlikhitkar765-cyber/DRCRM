<?php
/*
 * Copy this file to config.local.php in the same data/ directory.
 * That file is ignored by Git and is denied from the web by data/.htaccess.
 *
 * Use strings for every setting. Environment variables named DRCRM_<KEY>
 * override this file (for example DRCRM_DB_PASS).
 */
return [
    'DB_HOST' => 'localhost',
    'DB_PORT' => '3306',
    'DB_NAME' => 'drcrm',
    'DB_USER' => 'drcrm',
    'DB_PASS' => 'replace-with-a-strong-database-password',

    /* Canonical public URL used in QR codes and in patient-facing image links.
       Required for Smart Pad Link and handwritten/scan WhatsApp links. */
    'APP_URL' => 'https://clinic.example.com',

    /* A fresh production database needs an initial doctor account. Set both
       values, sign in once, then create/rotate staff accounts as required. */
    'INITIAL_DOCTOR_USERNAME' => 'doctor',
    'INITIAL_DOCTOR_PASSWORD' => 'replace-with-a-long-unique-password',
    'INITIAL_DOCTOR_NAME'     => 'Dr. Raja Bakshi',
    'INITIAL_DOCTOR_ROLE'     => 'doctor',

    /* Optional front-desk account for a fresh install. */
    'INITIAL_STAFF_USERNAME' => '',
    'INITIAL_STAFF_PASSWORD' => '',
    'INITIAL_STAFF_NAME'     => 'Front Desk',

    /* Set to 1 only for a private local demonstration database. It enables
       the known demo accounts and one-click demo buttons; never use on a
       public site containing real patient data. */
    'DEMO_MODE' => '0',

    /* WhatsApp Cloud API. Leave blank when using click-to-chat. Meta webhook
       requests are rejected until WA_APP_SECRET and WA_VERIFY_TOKEN are set. */
    'WA_DRIVER'       => 'link',
    'WA_PHONE_ID'     => '',
    'WA_TOKEN'        => '',
    'WA_APP_SECRET'   => '',
    'WA_VERIFY_TOKEN' => '',
    'WA_API_VERSION'  => 'v21.0',
];
